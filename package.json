{
  "name": "germanio",
  "private": true,
  "description": "Die Grenzen meiner Sprache — a local-first German learning OS",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "data:build": "pnpm --filter @germanio/data build:dictionary",
    "start": "turbo run dev --filter=@germanio/brain --filter=@germanio/lab --filter=@germanio/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@12.11.2"
}
