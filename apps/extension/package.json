{
  "name": "@germanio/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Germanio for Firefox — look up and mine any German word on the web",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@germanio/client": "workspace:*",
    "@germanio/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
