{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Popup and micro-card windows: show/hide themselves and receive events.",
  "windows": ["popup", "card"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
